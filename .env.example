# Your wallet address on Base — this is where USDC payments land
PAY_TO=0xYourWalletAddressHere

# Your 2captcha API key — get it at 2captcha.com
TWOCAPTCHA_API_KEY=your_2captcha_api_key_here

# Network: eip155:8453 = Base mainnet | eip155:84532 = Base Sepolia testnet
NETWORK=eip155:8453

# x402 facilitator — openx402.ai supports Base mainnet, x402.org only supports testnet
FACILITATOR_URL=https://facilitator.openx402.ai

# Price per solve in USD
PRICE=$0.30

# Port
PORT=3000
